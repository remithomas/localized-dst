{
  "name": "localized-dst",
  "version": "1.2.0",
  "description": "Determine if a date is in daylight savings time by country/state/city",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc",
    "publish-lib": "npm run build && npm publish",
    "publish-beta": "npm run build && npm publish --tag beta",
    "publish-dryrun": "npm run build && npm publish --dry-run",
    "prettier-format": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "dst",
    "daylight",
    "savings",
    "time",
    "country",
    "city",
    "date"
  ],
  "author": "Remi THOMAS",
  "contributors": [
    "Adrian EDWARDS"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remithomas/localized-dst.git"
  },
  "bugs": {
    "url": "https://github.com/remithomas/localized-dst/issues"
  },
  "homepage": "https://github.com/remithomas/localized-dst#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "moment-timezone": "^0.6.6",
    "typescript": "^6.0.3"
  }
}
